# A contributor's global ignore file may ignore everything, so what the project ships is re-included by name.
!/.env.example
!/.gitattributes
!/.gitignore
!/.node-version
!/.prettierignore
!/CONTRIBUTING.md
!/LICENSE
!/README.md
!/SECURITY.md
!/action.yml
!/eslint.config.mjs
!/package-lock.json
!/package.json
!/rollup.config.js

!/.github/
!/.github/**
!/__fixtures__/
!/__fixtures__/**
!/__tests__/
!/__tests__/**
!/demo/
!/demo/**
!/dist/
!/dist/**
!/rfcs/
!/rfcs/**
!/src/
!/src/**

node_modules/
coverage/
.env
.DS_Store
